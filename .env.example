# Garmin Connect credentials
# Option 1: Direct credentials (simple but less secure)
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password

# Option 2: File-based credentials (more secure, for Docker etc.)
# GARMIN_EMAIL_FILE=/path/to/email.txt
# GARMIN_PASSWORD_FILE=/path/to/password.txt

# Use Garmin Connect China (garmin.cn) instead of international
# GARMIN_IS_CN=false

# MCP Transport configuration
# GARMIN_MCP_TRANSPORT=stdio          # stdio | streamable-http | sse
# GARMIN_MCP_HOST=127.0.0.1           # Bind address for HTTP transports
# GARMIN_MCP_PORT=8000                # Bind port for HTTP transports

# Gemini API Key (from Google AI Studio - https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_ALLOWED_USER_ID=123456789  # Optional: limit bot access to your Telegram user ID
